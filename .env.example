# Copy to .env and fill in. compose.yaml refuses to start without these.

# CouchDB administrator. Used by CouchHub to provision and manage the server.
COUCHDB_USER=admin
COUCHDB_PASSWORD=

# Host port CouchDB is published on, for anything outside the compose network -
# a Cloudflare tunnel on the host, or a client on the LAN.
#
# Set COUCHDB_BIND=127.0.0.1 to keep it to the host itself.
COUCHDB_PORT=10021
# COUCHDB_BIND=127.0.0.1

# Host port the panel is published on.
#
# It defaults to the loopback address, not to every interface like CouchDB's:
# the panel has no login, so whatever can reach this port can read every vault's
# credentials. Put a tunnel or a proxy that authenticates in front of it, and
# only set COUCHHUB_BIND=0.0.0.0 if the LAN itself is the trust boundary.
COUCHHUB_PORT=10020
# COUCHHUB_BIND=0.0.0.0

# Seals credentials at rest in CouchHub's local store.
#
# Generate with:  openssl rand -base64 32
#
# Losing this makes every stored Setup URI and zone token unreadable, and vaults
# have to be reissued. Changing it has the same effect.
COUCHHUB_SECRET=

# Public hostnames. SYNC_DOMAIN is what goes into Setup URIs, so it must be
# reachable from phones; HUB_DOMAIN serves the panel.
#
# Both are read by the bundled Caddy, which is opt-in - `podman compose
# --profile proxy up -d`. They are still required when something else terminates
# the hostnames, a Cloudflare tunnel say, because compose interpolates the whole
# file whether or not that service starts.
SYNC_DOMAIN=sync.example.com
HUB_DOMAIN=hub.example.com

# Label for the CouchDB this file creates. It is registered and provisioned on
# first start, so the install wizard is normally skipped entirely.
COUCHHUB_COUCHDB_NAME=homelab

# The address clients are given for it is https://SYNC_DOMAIN, which is right
# whenever something terminates TLS for that hostname - Caddy, a Cloudflare
# tunnel, any reverse proxy. A deployment that publishes CouchDB some other way
# sets COUCHHUB_COUCHDB_PUBLIC_URL on the couchhub service in compose.yaml.

# How often vault statistics are refreshed.
COUCHHUB_POLL_INTERVAL=5m

# Vault document browser. Enabled by default.
#
# Reading a note decrypts it on the server and sends the contents to the browser.
# Set false to remove the feature entirely - the tab disappears and the endpoints
# answer 403, so it is closed rather than merely hidden.
# COUCHHUB_DOCUMENTS=false

# Override to run a locally built image instead of the published one.
# COUCHHUB_IMAGE=couchhub:local
